{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "epitomestudio",
	"compatibility_date": "2026-03-06",
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "epitomestudio"
		}
	],
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"CONTACT_EMAIL": "hello@epitomestudio.co.uk",
		"STUDIO_HIRE_EMAIL": "bookings@epitomestudio.co.uk",
		"EQUIPMENT_HIRE_EMAIL": "rentals@epitomestudio.co.uk",
		"RESEND_STUDIO_TOPIC_ID": "779fa857-b0be-43a4-baae-7312305f65c7",
		"RESEND_EQUIPMENT_TOPIC_ID": "b0c280ab-6402-4fe4-975b-3961f4ca37f2"
	},
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "f9535c192a1744eba286d65d3f789e8c"
		}
	],
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_id": "0dfce98c-f4a1-45c8-b628-f40d7ae58e15",
			"database_name": "epitomestudio-tag-cache"
		}
	],
	"workers_dev": true,
	"preview_urls": false
}